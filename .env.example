# LemonChat environment variables
VITE_APP_NAME=LemonChat
VITE_API_URL=/api
# Optional Socket.IO server origin (origin only; do not add /api or /socket.io).
# Leave empty to connect to this frontend's origin via the /socket.io proxy.
VITE_WS_URL=
# "dev" bypasses login/registration/OTP and cannot access authenticated backend features.
# Use production mode to test chats, friends, and other API-backed features.
VITE_APP_ENV=production

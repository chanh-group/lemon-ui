# LemonChat environment variables
VITE_APP_NAME=LemonChat
VITE_API_URL=/api
# Optional Socket.IO HTTP(S) origin; if cross-origin, allow this frontend in backend FRONTEND_URL.
# Leave empty to use the current origin through a /socket.io reverse proxy.
VITE_WS_URL=
# "dev" = bỏ qua xác thực (login/đăng ký/OTP), chỉ validate zod. Để trống hoặc "production" khi chạy thật.
VITE_APP_ENV=dev
